# ============================================================
# CLASISCO - Variables de entorno
# Copie este archivo a ".env" y ajuste los valores.
# NUNCA suba el archivo ".env" con datos reales a un repositorio.
# ============================================================

# Clave secreta de Django. En producción genere una segura con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=clave-secreta-de-desarrollo-cambiar-en-produccion

# Modo debug. En producción debe ser False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma:  *, www.midominio.com
DJANGO_ALLOWED_HOSTS=*

# Orígenes confiables para formularios (HTTPS):  https://www.midominio.com
CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---
# Motor: "sqlite3" (desarrollo) o "postgresql" (producción)
DB_ENGINE=sqlite3

# Valores usados cuando DB_ENGINE=postgresql
DB_NAME=clasisco
DB_USER=clasisco
DB_PASSWORD=cambiar-contraseña
DB_HOST=localhost
DB_PORT=5432

# --- HTTPS (producción) ---
# Actívelo con True cuando el sitio esté detrás de un proxy con HTTPS.
DJANGO_HTTPS=False